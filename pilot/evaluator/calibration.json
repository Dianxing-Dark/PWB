          "door_feedback"
        ],
        "mustPreserve": [
          "open_collision",
          "finish"
        ]
      },
      {
        "id": "dead_goal_trigger",
        "change": "角色通过门并进入出口，胜利触发器失效",
        "mustDetect": [
          "finish",
          "recover_and_finish"
        ],
        "mustPreserve": [
          "unlock_at_threshold",
          "open_collision"
        ]
      }
    ]
  },
  "moving-platform": {
