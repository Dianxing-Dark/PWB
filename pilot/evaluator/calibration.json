          "reject_wrong_color"
        ],
        "mustPreserve": [
          "pickup_unique",
          "unlock_correct_and_cross"
        ]
      },
      {
        "id": "unlock_without_consumption",
        "change": "门解锁后匹配钥匙未扣除",
        "mustDetect": [
          "unlock_correct_and_cross"
        ],
        "mustPreserve": [
          "pickup_unique",
          "reject_bypass"
        ]
      },
      {
        "id": "one_branch_cannot_finish",
