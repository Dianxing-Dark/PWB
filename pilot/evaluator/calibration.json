      {
        "id": "avatar_counts_as_cargo",
        "change": "玩家单独进入交付区也触发胜利",
        "mustDetect": [
          "no_empty_delivery"
        ],
        "mustPreserve": [
          "actual_support",
          "cargo_motion"
        ]
      }
    ]
  },
  "keys-and-resources": {
    "targetTask": "P05",
    "positiveControls": [
      "按物体接触事件记录拾取和消耗",
      "按场景组件与规则状态更新库存并使用不同合法路线布局"
    ],
    "emptyControl": "场景可启动，钥匙只是装饰物",
