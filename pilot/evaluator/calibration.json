      }
    ],
    "mutations": [
      {
        "id": "pickup_duplicates",
        "change": "多次经过已拾取位置会重复增加钥匙",
        "mustDetect": [
          "pickup_unique"
        ],
        "mustPreserve": [
          "reject_wrong_color",
          "reject_bypass"
        ]
      },
      {
        "id": "any_key_opens_upper",
        "change": "上层锁接受任意颜色的钥匙",
