  "platform": "browser-html-js",
  "dimension": "3D",
  "title": "3D 双压板通关与重试",
  "goal": "从正常入口完成双压板通关，并可在跌落后重试通关。",
  "controls": {
    "move": "W/A/S/D",
    "retryAfterFailure": "R",
    "start": "可见开始按钮或直接进入默认可玩场景"
  },
  "publicRules": [
    "箱子经正常移动接触后可推。压板 A 仅由实际接触该板的箱子激活。",
    "上层压板 B 仅由实际接触该板的玩家激活。",
    "同时激活从第 s 步开始，门在 s+120 步解锁；若任一板在该步或更早解除，则重新计时。",
    "解锁后可以立即通行，或在最多 30 步的开门动作结束后通行。门本次尝试内保持开启。",
    "玩家通过门洞并进入门后目标区才判定胜利。",
    "跌落明确进入失败态，R 重置尝试、物理对象、时钟及临时进度。"
  ],
  "layoutConstraints": [
    "下层压板 A 与上层区域的俯视投影有交集，两层可分别支撑物体，实际接触不会跨层发生。",
    "正常路径可经坡道到达上层板，门洞连接目标区，门关闭时无绕路直接进入目标区。",
    "存在可从正常入口到达的跌落边缘。"
  ],
  "clockAndUnits": {
    "simulationTickHz": 60,
    "coordinateUnits": "m",
    "upAxis": "+Y",
    "realInputClock": "monotonic milliseconds since browser launch",
    "eventOrder": "每步先更新输入与物理接触，再更新机关，最后记录观察数据"
  },
